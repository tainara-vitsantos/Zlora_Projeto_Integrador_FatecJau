@model EsqueciSenhaViewModel
@{ ViewData["Title"] = "Esqueci minha senha"; }
<section class="content-card registro">
    <h1>Esqueci minha senha</h1><p>Informe o e-mail da sua conta para receber um link de recuperação.</p>
    <form asp-action="EsqueciSenha" method="post">
        <div asp-validation-summary="All" class="validation" role="alert"></div>
        <div class="form-group"><label asp-for="Email">E-mail</label><input asp-for="Email" class="form-control" type="email" autocomplete="email" maxlength="254" required></div>
        <button class="btn btn-primary" type="submit">Enviar link</button><a asp-action="Login" class="ml-3">Voltar ao login</a>
    </form>
</section>
