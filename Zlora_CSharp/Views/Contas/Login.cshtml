@model LoginViewModel
@{ ViewData["Title"] = "Acessar"; }
<section class="auth-page">
    <div class="form-card auth-card">
        <div class="auth-heading">
            <a asp-controller="Home" asp-action="Index" class="navbar-brand">Zlora</a>
            <h1>Bem-vindo de volta</h1>
            <p class="login-subtitle">Acesse sua conta para gerenciar seu negócio.</p>
        </div>
        <form asp-action="Login" method="post">
            <div asp-validation-summary="All" class="validation" role="alert"></div>
            <div class="form-group"><label asp-for="Email">E-mail</label><input asp-for="Email" class="form-control" type="email" placeholder="seu@email.com" autocomplete="username" required></div>
            <div class="form-group"><label asp-for="Senha">Senha</label><div class="password-field"><input asp-for="Senha" class="form-control" type="password" placeholder="Sua senha" autocomplete="current-password" required><button type="button" data-toggle-password="Senha" aria-label="Mostrar senha">◉</button></div></div>
            <button class="btn btn-primary btn-block" type="submit">Entrar</button>
        </form>
        <p class="forgot-link"><a asp-action="EsqueciSenha">Esqueceu a senha?</a></p>
        <p class="account-link">Ainda não tem conta? <a asp-action="Registro">Cadastre-se</a></p>
        <p class="back-link"><a asp-controller="Home" asp-action="Index">← Voltar para a Home</a></p>
    </div>
</section>
